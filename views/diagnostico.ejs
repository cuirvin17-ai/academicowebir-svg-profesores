<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prueba de Diagnostico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        .nota-input { width: 70px; text-align: center; }
        .total-cell { font-weight: bold; font-size: 1.1em; }
        .desc-no { color: #dc3545; font-weight: bold; }
        .desc-prox { color: #fd7e14; font-weight: bold; }
        .desc-logro { color: #198754; font-weight: bold; }
        .desc-domina { color: #0d6efd; font-weight: bold; }
        .table td { vertical-align: middle; }
        .th-destreza { white-space: nowrap; min-width: 50px; }
    </style>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-primary text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-clipboard-list me-2"></i>Prueba de Diagnostico</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menu</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">

                <div class="card mb-3">
                    <div class="card-header"><i class="fas fa-filter me-1"></i>Seleccionar Materia y Curso</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Materia *</label>
                                <select class="form-select" id="materia_diag" onchange="cargarCursosDiag()">
                                    <option value="">Seleccionar materia...</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Curso *</label>
                                <select class="form-select" id="grupo_diag" onchange="cargarEstudiantesDiag()">
                                    <option value="">Seleccionar curso...</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card" id="tablaDiagCard" style="display: none;">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Diagnostico - <span id="nombreGrupoDiag"></span></span>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="form-label mb-0 me-1 fw-bold small">Calculo:</label>
                            <select class="form-select form-select-sm" id="modo_calculo" style="width:auto" onchange="cambiarModoCalculo()">
                                <option value="promedio">Promedio Normal (sobre 10)</option>
                                <option value="suma">Suma de Destrezas (total)</option>
                            </select>
                            <button class="btn btn-sm btn-success" onclick="agregarDestreza()">
                                <i class="fas fa-plus"></i> Agregar Destreza
                            </button>
                            <button class="btn btn-sm btn-warning" onclick="quitarDestreza()">
                                <i class="fas fa-minus"></i> Quitar Destreza
                            </button>
                            <button class="btn btn-sm btn-primary" onclick="guardarDiagnosticos()">
                                <i class="fas fa-save"></i> Guardar
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="exportarPDFDiagnostico()">
                                <i class="fas fa-file-pdf"></i> PDF
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm" id="tablaDiag">
                                <thead class="table-primary" id="tablaDiagHead"></thead>
                                <tbody id="tablaDiagBody"></tbody>
                            </table>
                        </div>
                        <div id="noEstudiantes" class="text-center text-muted py-4" style="display:none;">
                            <i class="fas fa-users-slash fa-3x mb-3"></i>
                            <p>No hay estudiantes asignados para este curso y materia.</p>
                        </div>

                        <div class="mt-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card border-primary">
                                        <div class="card-body text-center">
                                            <h6 class="card-title text-muted">Leyenda de Calificaciones</h6>
                                            <div class="d-flex flex-column gap-1">
                                                <span class="desc-domina"><i class="fas fa-star me-1"></i>9.00 - 10.00: Domina los aprendizajes</span>
                                                <span class="desc-logro"><i class="fas fa-check-circle me-1"></i>7.00 - 8.99: Alcanza los aprendizajes</span>
                                                <span class="desc-prox"><i class="fas fa-hourglass-half me-1"></i>4.01 - 6.99: Proximos a alcanzar los aprendizajes</span>
                                                <span class="desc-no"><i class="fas fa-times-circle me-1"></i>0.00 - 4.00: No alcanza los aprendizajes</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-info">
                                        <div class="card-body text-center">
                                            <h6 class="card-title text-muted">Resumen del Grupo</h6>
                                            <p class="mb-1">Total estudiantes: <strong id="totalEstudiantes">0</strong></p>
                                            <p class="mb-1">Domina: <strong id="countDomina" class="text-primary">0</strong></p>
                                            <p class="mb-1">Alcanza: <strong id="countAlcanza" class="text-success">0</strong></p>
                                            <p class="mb-1">Proximos: <strong id="countProximos" class="text-warning">0</strong></p>
                                            <p class="mb-0">No alcanza: <strong id="countNoAlcanza" class="text-danger">0</strong></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <script>
        let materiasDataDiag = [];
        let estudiantesDiag = [];
        let diagnosticosExistentes = [];
        let numDestrezas = 3;
        let currentMateriaInfo = null;
        let nombresDestrezas = {};

        function getModoCalculo() {
            return document.getElementById('modo_calculo')?.value || 'promedio';
        }

        function calcularTotalNotas(notas) {
            const modo = getModoCalculo();
            const vals = notas.filter(d => d !== null && d !== undefined);
            if (vals.length === 0) return 0;
            if (modo === 'suma') {
                return parseFloat(vals.reduce((sum, d) => sum + parseFloat(d), 0).toFixed(2));
            } else {
                return parseFloat((vals.reduce((sum, d) => sum + parseFloat(d), 0) / vals.length).toFixed(2));
            }
        }

        function cambiarModoCalculo() {
            renderTablaDiag();
        }

        function guardarNombresDestrezas() {
            if (!currentMateriaInfo) return;
            const key = `destrezas_${currentMateriaInfo.materia_id}_${currentMateriaInfo.curso}_${currentMateriaInfo.paralelo}`;
            localStorage.setItem(key, JSON.stringify(nombresDestrezas));
        }

        function cargarNombresDestrezas() {
            if (!currentMateriaInfo) return;
            const key = `destrezas_${currentMateriaInfo.materia_id}_${currentMateriaInfo.curso}_${currentMateriaInfo.paralelo}`;
            const guardados = localStorage.getItem(key);
            if (guardados) {
                nombresDestrezas = JSON.parse(guardados);
            } else {
                nombresDestrezas = {};
            }
        }

        function renombrarDestreza(num) {
            const nombreDefault = nombresDestrezas[num] || `D${num}`;
            const nombre = prompt(`Nombre de la destreza D${num}:`, nombreDefault);
            if (nombre !== null && nombre.trim() !== '') {
                nombresDestrezas[num] = nombre.trim();
                guardarNombresDestrezas();
                renderTablaDiag();
            }
        }

        function getDescripcion(total) {
            if (total >= 9.00) return 'Domina los aprendizajes';
            if (total >= 7.00) return 'Alcanza los aprendizajes';
            if (total >= 4.01) return 'Proximos a alcanzar los aprendizajes';
            return 'No alcanza los aprendizajes';
        }

        function getDescClass(total) {
            if (total >= 9.00) return 'desc-domina';
            if (total >= 7.00) return 'desc-logro';
            if (total >= 4.01) return 'desc-prox';
            return 'desc-no';
        }

        function colorNota(v) {
            if (v <= 0) return 'fw-bold';
            if (v <= 4) return 'fw-bold text-danger';
            if (v <= 6.99) return 'fw-bold text-warning';
            return 'fw-bold text-success';
        }

        async function cargarDatosDiag() {
            try {
                const res = await fetch('/api/diagnostico/materias');
                materiasDataDiag = await res.json();

                const selectMateria = document.getElementById('materia_diag');
                selectMateria.innerHTML = '<option value="">Seleccionar materia...</option>';

                const materiasUnicas = {};
                materiasDataDiag.forEach(m => {
                    if (!materiasUnicas[m.nombre_materia]) {
                        materiasUnicas[m.nombre_materia] = m.nombre_materia;
                    }
                });

                Object.keys(materiasUnicas).sort().forEach(nombre => {
                    const option = document.createElement('option');
                    option.value = nombre;
                    option.textContent = nombre;
                    selectMateria.appendChild(option);
                });
            } catch (err) {
                console.error('Error:', err);
            }
        }

        function cargarCursosDiag() {
            const nombreMateria = document.getElementById('materia_diag').value;
            const selectCurso = document.getElementById('grupo_diag');

            if (!nombreMateria) {
                selectCurso.innerHTML = '<option value="">Seleccionar curso...</option>';
                document.getElementById('tablaDiagCard').style.display = 'none';
                return;
            }

            const cursosFiltrados = materiasDataDiag.filter(m => m.nombre_materia === nombreMateria);

            selectCurso.innerHTML = '<option value="">Seleccionar curso...</option>';
            cursosFiltrados.forEach(m => {
                const option = document.createElement('option');
                option.value = JSON.stringify({ curso: m.curso, paralelo: m.paralelo, materia_id: m.id, nombre: m.nombre_materia, especialidad: m.especialidad });
                option.textContent = `${m.curso} - ${m.paralelo}${m.especialidad ? ' (' + m.especialidad + ')' : ''}`;
                selectCurso.appendChild(option);
            });

            document.getElementById('tablaDiagCard').style.display = 'none';
        }

        async function cargarEstudiantesDiag() {
            const val = document.getElementById('grupo_diag').value;
            if (!val) {
                document.getElementById('tablaDiagCard').style.display = 'none';
                return;
            }

            currentMateriaInfo = JSON.parse(val);
            const { curso, paralelo, materia_id } = currentMateriaInfo;

            document.getElementById('nombreGrupoDiag').textContent = `${curso} - ${paralelo}${currentMateriaInfo.especialidad ? ' (' + currentMateriaInfo.especialidad + ')' : ''}`;

            try {
                console.log('Buscando estudiantes:', { curso, paralelo, materia_id });
                const url = `/api/diagnostico/curso/${encodeURIComponent(curso)}/paralelo/${encodeURIComponent(paralelo)}/materia/${materia_id}/estudiantes`;
                console.log('URL:', url);
                const res = await fetch(url);
                const text = await res.text();
                console.log('Response status:', res.status, 'Body:', text);
                estudiantesDiag = JSON.parse(text);

                if (estudiantesDiag.length === 0) {
                    document.getElementById('tablaDiagCard').style.display = 'block';
                    document.getElementById('tablaDiagBody').innerHTML = '';
                    document.getElementById('tablaDiagHead').innerHTML = '';
                    document.getElementById('noEstudiantes').style.display = 'block';
                    return;
                }

                document.getElementById('noEstudiantes').style.display = 'none';

                const diagRes = await fetch(`/api/diagnostico/curso/${encodeURIComponent(curso)}/paralelo/${encodeURIComponent(paralelo)}/materia/${materia_id}/diagnosticos`);
                const diagData = await diagRes.json();
                diagnosticosExistentes = Array.isArray(diagData) ? diagData : [];
            } catch (err) {
                console.error('Error cargando datos:', err);
                alert('Error al cargar estudiantes: ' + err.message);
                return;
            }

            if (diagnosticosExistentes.length > 0 && diagnosticosExistentes[0].destrezas) {
                const primerDiag = typeof diagnosticosExistentes[0].destrezas === 'string'
                    ? JSON.parse(diagnosticosExistentes[0].destrezas)
                    : diagnosticosExistentes[0].destrezas;
                numDestrezas = primerDiag.length;
            }

            renderTablaDiag();
            document.getElementById('tablaDiagCard').style.display = 'block';
        }

        function renderTablaDiag() {
            const thead = document.getElementById('tablaDiagHead');
            const tbody = document.getElementById('tablaDiagBody');

            let headerRow1 = '<th>Estudiante</th>';
            let headerRow2 = '<th></th>';

            cargarNombresDestrezas();
            for (let i = 1; i <= numDestrezas; i++) {
                if (!nombresDestrezas[i]) nombresDestrezas[i] = `D${i}`;
            }
            guardarNombresDestrezas();

            headerRow1 += `<th class="text-center" colspan="${numDestrezas + 2}">Destrezas (0-10)</th>`;
            for (let i = 1; i <= numDestrezas; i++) {
                const nombre = nombresDestrezas[i] || `D${i}`;
                headerRow2 += `<th class="text-center th-destreza py-1">
                    <div class="d-flex align-items-center justify-content-center gap-1">
                        <small class="fw-bold">${nombre}</small>
                        <button class="btn btn-link btn-sm p-0 text-muted" onclick="renombrarDestreza(${i})" title="Renombrar" style="font-size:10px;text-decoration:none"><i class="fas fa-pen"></i></button>
                    </div>
                </th>`;
            }
            const modoLabel = getModoCalculo() === 'suma' ? 'Suma' : 'Promedio';
            headerRow2 += `<th class="text-center" style="min-width:50px"><div style="writing-mode:vertical-lr;transform:rotate(180deg)">Total (${modoLabel})</div></th>`;
            headerRow2 += '<th class="text-center" style="min-width:80px"><div style="writing-mode:vertical-lr;transform:rotate(180deg)">Descripcion</div></th>';

            thead.innerHTML = `<tr>${headerRow1}</tr><tr>${headerRow2}</tr>`;

            let bodyHtml = '';
            let countD = 0, countA = 0, countP = 0, countN = 0;

            estudiantesDiag.forEach((est, idx) => {
                const diagExistente = diagnosticosExistentes.find(d => d.estudiante_id === est.id);
                let destrezasExistentes = [];
                if (diagExistente && diagExistente.destrezas) {
                    destrezasExistentes = typeof diagExistente.destrezas === 'string'
                        ? JSON.parse(diagExistente.destrezas)
                        : diagExistente.destrezas;
                }

                let total = 0;
                if (destrezasExistentes.length > 0) {
                    total = calcularTotalNotas(destrezasExistentes);
                }
                total = parseFloat(total.toFixed(2));
                const desc = getDescripcion(total);
                const descClass = getDescClass(total);

                if (total >= 9.00) countD++;
                else if (total >= 7.00) countA++;
                else if (total >= 4.01) countP++;
                else if (total > 0) countN++;

                bodyHtml += `<tr data-estudiante="${est.id}">
                    <td>${nombreEstudiante(est.nombres_apellidos, est.discapacidad)}</td>`;

                for (let i = 0; i < numDestrezas; i++) {
                    const val = destrezasExistentes[i] !== undefined && destrezasExistentes[i] !== null ? destrezasExistentes[i] : '';
                    bodyHtml += `<td class="text-center">
                        <input type="number" class="form-control form-control-sm nota-input text-center" min="0" max="10" step="0.01"
                            value="${val}" data-estudiante="${est.id}" data-idx="${i}"
                            onchange="calcularTotalFila(this)">
                    </td>`;
                }

                bodyHtml += `<td class="text-center total-cell total-${est.id}" data-est="${est.id}">${total > 0 ? total.toFixed(2) : '-'}</td>
                    <td class="text-center fw-bold ${descClass} desc-${est.id}" data-est="${est.id}">${total > 0 ? desc : '-'}</td></tr>`;
            });

            tbody.innerHTML = bodyHtml;

            if (estudiantesDiag.length > 0) {
                let promCols = [];
                for (let i = 0; i < numDestrezas; i++) {
                    let suma = 0, count = 0;
                    document.querySelectorAll(`input[data-idx="${i}"]`).forEach(inp => {
                        const v = parseFloat(inp.value);
                        if (!isNaN(v)) { suma += v; count++; }
                    });
                    promCols.push(count > 0 ? (suma / count).toFixed(2) : '-');
                }

                let totalSuma = 0, totalCt = 0;
                document.querySelectorAll(`.total-cell[data-est]`).forEach(el => {
                    const v = parseFloat(el.textContent);
                    if (!isNaN(v) && v > 0) { totalSuma += v; totalCt++; }
                });
                const promGeneral = totalCt > 0 ? (totalSuma / totalCt).toFixed(2) : '-';

                let promRow = `<tr class="table-secondary fw-bold"><td>PROMEDIOS</td>`;
                promCols.forEach(p => {
                    promRow += `<td class="text-center">${p}</td>`;
                });
                promRow += `<td class="text-center">${promGeneral}</td><td></td></tr>`;
                tbody.innerHTML += promRow;
            }

            document.getElementById('totalEstudiantes').textContent = estudiantesDiag.length;
            document.getElementById('countDomina').textContent = countD;
            document.getElementById('countAlcanza').textContent = countA;
            document.getElementById('countProximos').textContent = countP;
            document.getElementById('countNoAlcanza').textContent = countN;
        }

        function calcularTotalFila(input) {
            const val = parseFloat(input.value);
            if (input.value !== '' && (isNaN(val) || val < 0 || val > 10)) {
                input.value = '';
                return;
            }

            const tr = input.closest('tr');
            const estId = input.dataset.estudiante;
            const inputs = tr.querySelectorAll('.nota-input');
            let count = 0;
            inputs.forEach(inp => {
                const v = parseFloat(inp.value);
                if (!isNaN(v)) count++;
            });

            const totalEl = tr.querySelector(`.total-${estId}`);
            const descEl = tr.querySelector(`.desc-${estId}`);

            if (count > 0) {
                const notas = [];
                inputs.forEach(inp => {
                    const v = parseFloat(inp.value);
                    notas.push(isNaN(v) ? null : v);
                });
                const total = calcularTotalNotas(notas);
                totalEl.textContent = total > 0 ? total.toFixed(2) : '-';
                totalEl.className = `text-center total-cell ${colorNota(total)} total-${estId}`;
                descEl.textContent = total > 0 ? getDescripcion(total) : '-';
                descEl.className = `text-center fw-bold ${getDescClass(total)} desc-${estId}`;
            } else {
                totalEl.textContent = '-';
                totalEl.className = `text-center total-cell total-${estId}`;
                descEl.textContent = '-';
                descEl.className = `text-center fw-bold desc-${estId}`;
            }

            actualizarResumenDiag();
        }

        function actualizarResumenDiag() {
            let countD = 0, countA = 0, countP = 0, countN = 0;
            estudiantesDiag.forEach(est => {
                const totalEl = document.querySelector(`.total-${est.id}`);
                if (!totalEl || totalEl.textContent === '-') return;
                const total = parseFloat(totalEl.textContent);
                if (total >= 9.00) countD++;
                else if (total >= 7.00) countA++;
                else if (total >= 4.01) countP++;
                else countN++;
            });
            document.getElementById('countDomina').textContent = countD;
            document.getElementById('countAlcanza').textContent = countA;
            document.getElementById('countProximos').textContent = countP;
            document.getElementById('countNoAlcanza').textContent = countN;
        }

        function agregarDestreza() {
            numDestrezas++;
            renderTablaDiag();
        }

        function quitarDestreza() {
            if (numDestrezas <= 1) return alert('Debe haber al menos una destreza');
            numDestrezas--;
            renderTablaDiag();
        }

        function exportarPDFDiagnostico() {
            const tabla = document.getElementById('tablaDiag');
            if (!tabla || tabla.rows.length <= 1) return alert('No hay datos para exportar');
            const grupo = document.getElementById('nombreGrupoDiag').textContent;
            const materia = document.getElementById('materia_diag').value;
            const modoLabel = getModoCalculo() === 'suma' ? 'Suma' : 'Promedio';

            let pdfHtml = `<table border="1" cellpadding="4" cellspacing="0" style="border-collapse:collapse;width:100%;font-size:11px;">
                <thead><tr style="background:#4a7fc1;color:#fff;">
                    <th>Estudiante</th>`;
            for (let i = 1; i <= numDestrezas; i++) {
                pdfHtml += `<th style="text-align:center">${nombresDestrezas[i] || 'D'+i}</th>`;
            }
            pdfHtml += `<th style="text-align:center">${modoLabel}</th>
                <th style="text-center">Descripcion</th></tr></thead><tbody>`;

            const inputs = tabla.querySelectorAll('tr[data-estudiante]');
            inputs.forEach(tr => {
                const estId = tr.dataset.estudiante;
                const nombre = tr.cells[0].textContent;
                pdfHtml += `<tr><td>${nombre}</td>`;
                for (let i = 0; i < numDestrezas; i++) {
                    const inp = tr.querySelector(`input[data-idx="${i}"]`);
                    pdfHtml += `<td style="text-align:center">${inp ? (inp.value || '-') : '-'}</td>`;
                }
                const totalEl = tr.querySelector(`.total-${estId}`);
                const descEl = tr.querySelector(`.desc-${estId}`);
                pdfHtml += `<td style="text-align:center;font-weight:bold">${totalEl ? totalEl.textContent : '-'}</td>`;
                pdfHtml += `<td style="text-align:center">${descEl ? descEl.textContent : '-'}</td></tr>`;
            });

            const promRow = tabla.querySelector('tr.table-secondary');
            if (promRow) {
                pdfHtml += `<tr style="background:#e9ecef;font-weight:bold"><td>PROMEDIOS</td>`;
                const cells = promRow.querySelectorAll('td');
                for (let i = 1; i < cells.length; i++) {
                    pdfHtml += `<td style="text-align:center">${cells[i].textContent}</td>`;
                }
                pdfHtml += '</tr>';
            }
            pdfHtml += '</tbody></table>';

            const config = {
                margin: [10, 5, 10, 5],
                filename: `Diagnostico_${materia}_${grupo}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };
            const div = document.createElement('div');
            div.innerHTML = `<h4 style="text-align:center;margin-bottom:5px;">Prueba de Diagnostico</h4>
                <h5 style="text-align:center;margin-bottom:10px;">${materia} - ${grupo}</h5>` + pdfHtml;
            html2pdf().set(config).from(div).save();
        }

        async function guardarDiagnosticos() {
            if (!currentMateriaInfo) return alert('Seleccione materia y curso');

            const diagnosticos = [];
            estudiantesDiag.forEach(est => {
                const inputs = document.querySelectorAll(`tr[data-estudiante="${est.id}"] .nota-input`);
                const destrezas = [];
                inputs.forEach(inp => {
                    const val = inp.value.trim();
                    destrezas.push(val !== '' ? parseFloat(val) : null);
                });

                const valoresValidos = destrezas.filter(d => d !== null);
                if (valoresValidos.length === 0) return;

                const total = calcularTotalNotas(destrezas);

                diagnosticos.push({
                    estudiante_id: est.id,
                    materia_id: currentMateriaInfo.materia_id,
                    curso: currentMateriaInfo.curso,
                    paralelo: currentMateriaInfo.paralelo,
                    destrezas: destrezas,
                    total: total
                });
            });

            if (diagnosticos.length === 0) {
                return alert('Ingrese al menos una nota para guardar');
            }

            try {
                const res = await fetch('/api/diagnostico/guardar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ diagnosticos })
                });
                const data = await res.json();
                if (res.ok) {
                    alert(data.message);
                    cargarEstudiantesDiag();
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (err) {
                alert('Error al guardar: ' + err.message);
            }
        }

        document.addEventListener('DOMContentLoaded', cargarDatosDiag);
    </script>
</body>
</html>
