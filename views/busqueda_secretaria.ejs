<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Busqueda de Estudiantes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-header text-white p-3 shadow">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h5 mb-0 d-flex align-items-center">
                    <img src="/images/sucua2.png" alt="Logo" style="width:40px; height:40px; border-radius:50%; margin-right:10px; border: 2px solid rgba(255,255,255,0.3);">
                    <i class="fas fa-search me-2"></i>Busqueda de Estudiantes
                </h1>
                <button class="btn-menu" onclick="showMenu()">
                    <i class="fas fa-home me-1"></i> Menu
                </button>
            </div>
        </header>

        <main class="flex-grow-1 overflow-auto py-3" style="background: #f0f4f8;">
            <div class="container">
                <!-- Filtros de busqueda -->
                <div class="card mb-4">
                    <div class="card-header" style="background: linear-gradient(135deg, #1565c0, #0d47a1); color: white;">
                        <i class="fas fa-filter me-1"></i>Filtros de Busqueda
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <!-- Sexo -->
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-bold">Genero</label>
                                <select class="form-select" id="filtroSexo">
                                    <option value="">Todos</option>
                                    <option value="M">Masculino</option>
                                    <option value="F">Femenino</option>
                                </select>
                            </div>

                            <!-- Edad -->
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-bold">Edad Minima</label>
                                <input type="number" class="form-control" id="filtroEdadMin" placeholder="Ej: 10" min="1" max="20">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-bold">Edad Maxima</label>
                                <input type="number" class="form-control" id="filtroEdadMax" placeholder="Ej: 15" min="1" max="20">
                            </div>

                            <!-- Ciudad -->
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-bold">Ciudad</label>
                                <select class="form-select" id="filtroCiudad">
                                    <option value="">Todas</option>
                                </select>
                            </div>

                            <!-- Anio nacimiento -->
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-bold">Anio Nacimiento Desde</label>
                                <input type="number" class="form-control" id="filtroAnioNacMin" placeholder="Ej: 2008" min="1990" max="2020">
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-bold">Anio Nacimiento Hasta</label>
                                <input type="number" class="form-control" id="filtroAnioNacMax" placeholder="Ej: 2012" min="1990" max="2020">
                            </div>

                            <!-- Discapacidad -->
                            <div class="col-md-3 col-sm-6">
                                <label class="form-label fw-bold">Discapacidad</label>
                                <select class="form-select" id="filtroDiscapacidad">
                                    <option value="">Todas</option>
                                    <option value="SI">Con Discapacidad</option>
                                    <option value="NO">Sin Discapacidad</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-action btn-guardar" onclick="buscarEstudiantes()">
                                <i class="fas fa-search me-1"></i>Buscar
                            </button>
                            <button class="btn btn-action btn-quitar" onclick="limpiarFiltros()">
                                <i class="fas fa-times me-1"></i>Limpiar
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Resultados -->
                <div class="card" id="resultadosCard" style="display: none;">
                    <div class="card-header d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #1565c0, #0d47a1); color: white;">
                        <span><i class="fas fa-users me-1"></i>Resultados: <span id="totalResultados">0</span> estudiantes</span>
                        <div class="d-flex gap-2">
                            <button class="btn btn-action btn-pdf btn-sm" onclick="exportarPDF()">
                                <i class="fas fa-file-pdf me-1"></i>PDF
                            </button>
                            <button class="btn btn-action btn-excel btn-sm" onclick="exportarExcel()">
                                <i class="fas fa-file-excel me-1"></i>Excel
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-sm" id="tablaResultados">
                                <thead style="background: linear-gradient(135deg, #1565c0, #0d47a1); color: white;">
                                    <tr>
                                        <th>#</th>
                                        <th>Cedula</th>
                                        <th>Nombre Completo</th>
                                        <th> Sexo</th>
                                        <th>Fecha Nac.</th>
                                        <th>Edad</th>
                                        <th>Ciudad</th>
                                        <th>Curso</th>
                                        <th>Paralelo</th>
                                        <th>Discapacidad</th>
                                        <th>Representante</th>
                                        <th>Telefono</th>
                                    </tr>
                                </thead>
                                <tbody id="cuerpoTabla"></tbody>
                            </table>
                        </div>
                        <div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
                            <i class="fas fa-search fa-3x mb-3"></i>
                            <p>No se encontraron estudiantes con los filtros seleccionados.</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-footer text-center p-2">
            <small>&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <script>
        let datosEstudiantes = [];

        document.addEventListener('DOMContentLoaded', cargarCiudades);

        async function cargarCiudades() {
            try {
                const res = await fetch('/api/secretaria/busqueda/ciudades');
                const ciudades = await res.json();
                const select = document.getElementById('filtroCiudad');
                ciudades.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c;
                    opt.textContent = c;
                    select.appendChild(opt);
                });
            } catch (err) {
                console.error('Error cargando ciudades:', err);
            }
        }

        async function buscarEstudiantes() {
            const params = new URLSearchParams();
            const sexo = document.getElementById('filtroSexo').value;
            const edadMin = document.getElementById('filtroEdadMin').value;
            const edadMax = document.getElementById('filtroEdadMax').value;
            const anioNacMin = document.getElementById('filtroAnioNacMin').value;
            const anioNacMax = document.getElementById('filtroAnioNacMax').value;
            const ciudad = document.getElementById('filtroCiudad').value;
            const discapacidad = document.getElementById('filtroDiscapacidad').value;

            if (sexo) params.append('sexo', sexo);
            if (edadMin) params.append('edad_min', edadMin);
            if (edadMax) params.append('edad_max', edadMax);
            if (anioNacMin) params.append('anio_nac_min', anioNacMin);
            if (anioNacMax) params.append('anio_nac_max', anioNacMax);
            if (ciudad) params.append('ciudad', ciudad);
            if (discapacidad) params.append('discapacidad', discapacidad);

            try {
                const res = await fetch('/api/secretaria/busqueda/buscar?' + params.toString());
                datosEstudiantes = await res.json();
                renderTabla(datosEstudiantes);
            } catch (err) {
                alert('Error al buscar estudiantes');
                console.error(err);
            }
        }

        function renderTabla(datos) {
            const tbody = document.getElementById('cuerpoTabla');
            const card = document.getElementById('resultadosCard');
            const sinResultados = document.getElementById('sinResultados');

            card.style.display = 'block';
            document.getElementById('totalResultados').textContent = datos.length;

            if (datos.length === 0) {
                tbody.innerHTML = '';
                sinResultados.style.display = 'block';
                return;
            }

            sinResultados.style.display = 'none';
            tbody.innerHTML = datos.map((e, i) => {
                const sexoLabel = e.sexo === 'M' ? 'MASC' : 'FEM';
                const sexoClass = e.sexo === 'M' ? 'text-primary' : 'text-danger';
                const discLabel = (e.discapacidad && e.discapacidad !== 'NO') ? e.discapacidad_tipo || e.discapacidad : 'NINGUNA';
                const discClass = (e.discapacidad && e.discapacidad !== 'NO') ? 'text-warning fw-bold' : 'text-muted';
                const fechaNac = e.fecha_nacimiento ? new Date(e.fecha_nacimiento).toLocaleDateString('es-EC') : '-';
                return `
                    <tr>
                        <td>${i + 1}</td>
                        <td>${e.cedula || '-'}</td>
                        <td>${e.nombres_apellidos}</td>
                        <td class="${sexoClass} fw-bold">${sexoLabel}</td>
                        <td>${fechaNac}</td>
                        <td>${e.edad || '-'}</td>
                        <td>${e.ciudad || '-'}</td>
                        <td>${e.curso || '-'}</td>
                        <td>${e.paralelo || '-'}</td>
                        <td class="${discClass}">${discLabel}</td>
                        <td>${e.representante || '-'}</td>
                        <td>${e.telefono_representante || '-'}</td>
                    </tr>
                `;
            }).join('');
        }

        function limpiarFiltros() {
            document.getElementById('filtroSexo').value = '';
            document.getElementById('filtroEdadMin').value = '';
            document.getElementById('filtroEdadMax').value = '';
            document.getElementById('filtroAnioNacMin').value = '';
            document.getElementById('filtroAnioNacMax').value = '';
            document.getElementById('filtroCiudad').value = '';
            document.getElementById('filtroDiscapacidad').value = '';
            document.getElementById('resultadosCard').style.display = 'none';
            datosEstudiantes = [];
        }

        function exportarPDF() {
            if (datosEstudiantes.length === 0) return alert('No hay datos para exportar');

            const filtros = [];
            const sexo = document.getElementById('filtroSexo').value;
            const edadMin = document.getElementById('filtroEdadMin').value;
            const edadMax = document.getElementById('filtroEdadMax').value;
            const anioNacMin = document.getElementById('filtroAnioNacMin').value;
            const anioNacMax = document.getElementById('filtroAnioNacMax').value;
            const ciudad = document.getElementById('filtroCiudad').value;
            const discapacidad = document.getElementById('filtroDiscapacidad').value;

            if (sexo) filtros.push(`Genero: ${sexo === 'M' ? 'Masculino' : 'Femenino'}`);
            if (edadMin || edadMax) filtros.push(`Edad: ${edadMin || '0'} - ${edadMax || '?'}`);
            if (anioNacMin || anioNacMax) filtros.push(`Anio Nac: ${anioNacMin || '?'} - ${anioNacMax || '?'}`);
            if (ciudad) filtros.push(`Ciudad: ${ciudad}`);
            if (discapacidad) filtros.push(`Discapacidad: ${discapacidad === 'SI' ? 'Si' : 'No'}`);

            const tabla = document.getElementById('tablaResultados').cloneNode(true);
            tabla.querySelectorAll('tr').forEach(tr => {
                tr.style.fontSize = '11px';
            });

            const html = `
                <div style="text-align:center; margin-bottom:15px;">
                    <h2 style="margin:0; font-size:18px;">Reporte de Estudiantes</h2>
                    <p style="margin:2px 0; font-size:11px; color:#666;">Filtros: ${filtros.length > 0 ? filtros.join(' | ') : 'Sin filtros'}</p>
                    <p style="margin:2px 0; font-size:10px; color:#999;">Total: ${datosEstudiantes.length} estudiantes | Generado: ${new Date().toLocaleDateString('es-EC')}</p>
                </div>
            `;

            const config = {
                margin: [10, 5, 10, 5],
                filename: 'busqueda_estudiantes.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };

            const div = document.createElement('div');
            div.innerHTML = html;
            div.appendChild(tabla);
            html2pdf().set(config).from(div).save();
        }

        function exportarExcel() {
            if (datosEstudiantes.length === 0) return alert('No hay datos para exportar');

            const data = [['#', 'Cedula', 'Nombre Completo', ' Sexo', 'Fecha Nacimiento', 'Edad', 'Ciudad', 'Provincia', 'Curso', 'Paralelo', 'Especialidad', 'Discapacidad', 'Tipo Discapacidad', 'Representante', 'Telefono Representante', 'Email Representante']];

            datosEstudiantes.forEach((e, i) => {
                data.push([
                    i + 1,
                    e.cedula || '',
                    e.nombres_apellidos,
                    e.sexo === 'M' ? 'Masculino' : 'Femenino',
                    e.fecha_nacimiento ? new Date(e.fecha_nacimiento).toLocaleDateString('es-EC') : '',
                    e.edad || '',
                    e.ciudad || '',
                    e.provincia || '',
                    e.curso || '',
                    e.paralelo || '',
                    e.especialidad || '',
                    (e.discapacidad && e.discapacidad !== 'NO') ? 'SI' : 'NO',
                    e.discapacidad_tipo || '',
                    e.representante || '',
                    e.telefono_representante || '',
                    e.email_representante || ''
                ]);
            });

            const ws = XLSX.utils.aoa_to_sheet(data);
            ws['!cols'] = [
                { wch: 5 }, { wch: 15 }, { wch: 35 }, { wch: 12 }, { wch: 15 },
                { wch: 6 }, { wch: 18 }, { wch: 18 }, { wch: 15 }, { wch: 10 },
                { wch: 15 }, { wch: 15 }, { wch: 20 }, { wch: 25 }, { wch: 15 }, { wch: 25 }
            ];

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Estudiantes');
            XLSX.writeFile(wb, 'busqueda_estudiantes.xlsx');
        }
    </script>
</body>
</html>
