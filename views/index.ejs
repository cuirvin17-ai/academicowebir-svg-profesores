<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Principal - Sistema de Gestion Academica</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
</head>
<body>
    <div class="bg-menu d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                        <div class="card-header bg-primary text-white text-center py-4">
                            <h1 class="h2 mb-0">
                                <img src="/images/sucua2.png" alt="Logo" style="width:50px; height:50px; border-radius:50%; margin-right:8px;">
                                Sistema de Gestion Academica
                            </h1>
                            <div class="mt-2">
                                <label class="text-white-50 me-2">Periodo:</label>
                                <select id="selectorAnio" class="form-select form-select-sm d-inline-block w-auto" onchange="cambiarAnio(this.value)">
                                </select>
                            </div>
                            <p class="mb-0 mt-1">
                                <small>
                                    <% const rolLabels = {docente:'Docente',secretaria:'Secretaria',rector:'Rector',inspector:'Inspector'}; %>
                                    <i class="fas fa-user me-1"></i><%= user.nombre %> - <%= rolLabels[user.rol] || user.rol %>
                                </small>
                            </p>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">

                                <% if (user.rol === 'docente') { %>
                                <div class="col-6 col-md-4">
                                    <a href="/api/diagnostico/view" class="menu-item btn btn-outline-dark w-100 h-100 py-3">
                                        <i class="fas fa-clipboard-list fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Prueba Diagnostico</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/notas/view" class="menu-item btn btn-outline-primary w-100 h-100 py-3">
                                        <i class="fas fa-chart-bar fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Notas Trimestrales</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/asistencias/view" class="menu-item btn btn-outline-primary w-100 h-100 py-3">
                                        <i class="fas fa-clipboard-check fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Asistencia</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/alertas/view" class="menu-item btn btn-outline-warning w-100 h-100 py-3">
                                        <i class="fas fa-exclamation-triangle fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Alertas</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/recuperacion/view" class="menu-item btn btn-outline-secondary w-100 h-100 py-3">
                                        <i class="fas fa-hands-helping fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Recuperacion Pedagogica</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/reportes/view" class="menu-item btn btn-outline-primary w-100 h-100 py-3">
                                        <i class="fas fa-file-alt fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Reportes</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/informes/view" class="menu-item btn btn-outline-success w-100 h-100 py-3">
                                        <i class="fas fa-file-contract fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Informes</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/recursos/view" class="menu-item btn btn-outline-info w-100 h-100 py-3">
                                        <i class="fas fa-book-open fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Recursos</span>
                                    </a>
                                </div>
                                <% } %>

                                <% if (user.rol === 'rector') { %>
                                <div class="col-6 col-md-4">
                                    <a href="/api/rector/view" class="menu-item btn btn-outline-danger w-100 h-100 py-3">
                                        <i class="fas fa-school fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Gestion Academica</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/admin/view" class="menu-item btn btn-outline-dark w-100 h-100 py-3">
                                        <i class="fas fa-users-cog fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Admin Usuarios</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/anio-lectivos/view" class="menu-item btn btn-outline-primary w-100 h-100 py-3">
                                        <i class="fas fa-calendar-alt fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Años Lectivos</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/informes/view" class="menu-item btn btn-outline-success w-100 h-100 py-3">
                                        <i class="fas fa-file-contract fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Informes</span>
                                    </a>
                                </div>
                                <% } %>

                                <% if (user.rol === 'inspector') { %>
                                <div class="col-6 col-md-4">
                                    <a href="/api/inspector/estudiantes/view" class="menu-item btn btn-outline-primary w-100 h-100 py-3">
                                        <i class="fas fa-user-graduate fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Estudiantes</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/asistencias/view" class="menu-item btn btn-outline-primary w-100 h-100 py-3">
                                        <i class="fas fa-clipboard-check fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Asistencia</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/reportes/view" class="menu-item btn btn-outline-success w-100 h-100 py-3">
                                        <i class="fas fa-file-alt fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Reportes</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/alertas/view" class="menu-item btn btn-outline-warning w-100 h-100 py-3">
                                        <i class="fas fa-exclamation-triangle fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Alertas</span>
                                    </a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <a href="/api/justificaciones/view" class="menu-item btn btn-outline-info w-100 h-100 py-3">
                                        <i class="fas fa-clipboard-list fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Justificaciones</span>
                                    </a>
                                </div>
                                <% } %>

                                <% if (user.rol === 'secretaria') { %>
                                <div class="col-6 col-md-4">
                                    <a href="/api/secretaria/view" class="menu-item btn btn-outline-info w-100 h-100 py-3">
                                        <i class="fas fa-user-graduate fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Ingreso de Estudiantes</span>
                                    </a>
                                </div>
                                <% } %>

                                <div class="col-6 col-md-4">
                                    <button onclick="window.location.href='/logout'" class="menu-item btn btn-outline-danger w-100 h-100 py-3">
                                        <i class="fas fa-sign-out-alt fa-2x mb-2 d-block"></i>
                                        <span class="d-block">Salir</span>
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        const anioActual = '<%= user.anio_lectivo || "2026-2027" %>';

        document.addEventListener('DOMContentLoaded', cargarAnios);

        async function cargarAnios() {
            try {
                const res = await fetch('/api/years');
                const years = await res.json();
                const select = document.getElementById('selectorAnio');
                select.innerHTML = years.map(y =>
                    `<option value="${y}" ${y === anioActual ? 'selected' : ''}>${y}</option>`
                ).join('');
            } catch (err) {
                document.getElementById('selectorAnio').innerHTML = '<option value="2026-2027">2026-2027</option>';
            }
        }

        async function cambiarAnio(year) {
            try {
                const res = await fetch('/api/change-year', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ anio_lectivo: year })
                });
                const result = await res.json();
                if (res.ok) {
                    window.location.reload();
                }
            } catch (err) {
                alert('Error al cambiar año lectivo');
            }
        }
    </script>
</body>
</html>
