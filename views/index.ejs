<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Principal - Sistema de Gestion Academica</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Inter', sans-serif; margin: 0; padding: 0; }

        .bg-menu {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: url('/images/fondo-login.jpeg') no-repeat center center;
            background-size: cover;
            animation: zoomPan 20s ease-in-out infinite alternate;
            z-index: -2;
        }
        @keyframes zoomPan {
            0% { transform: scale(1) translate(0, 0); }
            100% { transform: scale(1.1) translate(-1%, -1%); }
        }

        .overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(2px);
            z-index: -1;
        }

        body { min-height: 100vh; }

        .main-wrapper {
            max-width: 800px;
            margin: 0 auto;
            animation: fadeInUp 0.6s ease-out;
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .main-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 24px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .card-header-custom {
            background: rgba(13, 71, 161, 0.7);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            padding: 30px;
            text-align: center;
            color: white;
        }
        .card-header-custom img {
            width: 60px; height: 60px;
            border-radius: 50%;
            border: 3px solid rgba(255, 255, 255, 0.3);
            margin-bottom: 10px;
        }
        .card-header-custom h1 {
            font-size: 1.5em;
            font-weight: 700;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
            margin-bottom: 10px;
        }
        .card-header-custom .user-info {
            font-weight: 300;
            font-size: 0.9em;
            opacity: 0.9;
        }

        .period-selector {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.15);
            padding: 6px 14px;
            border-radius: 20px;
            margin-top: 8px;
        }
        .period-selector label {
            font-size: 0.85em;
            font-weight: 400;
            margin: 0;
        }
        .period-selector select {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            border-radius: 8px;
            padding: 4px 8px;
            font-size: 0.85em;
        }
        .period-selector select option { color: #333; background: white; }

        .menu-grid {
            padding: 25px;
        }

        .menu-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px 10px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            min-height: 110px;
        }
        .menu-btn::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
            transition: left 0.5s ease;
        }
        .menu-btn:hover::before { left: 100%; }
        .menu-btn:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            background: rgba(255, 255, 255, 0.2);
            color: white;
            text-decoration: none;
        }
        .menu-btn:active { transform: translateY(-2px); }

        .menu-btn i {
            font-size: 2em;
            margin-bottom: 10px;
            opacity: 0.9;
            transition: all 0.3s ease;
        }
        .menu-btn:hover i {
            transform: scale(1.15);
            opacity: 1;
        }
        .menu-btn span {
            font-weight: 500;
            font-size: 0.85em;
            text-align: center;
        }

        .menu-btn.btn-diagnostico { border-left: 3px solid #fff; }
        .menu-btn.btn-diagnostico i { color: #ffffff; }

        .menu-btn.btn-notas { border-left: 3px solid #42a5f5; }
        .menu-btn.btn-notas i { color: #42a5f5; }

        .menu-btn.btn-asistencia { border-left: 3px solid #66bb6a; }
        .menu-btn.btn-asistencia i { color: #66bb6a; }

        .menu-btn.btn-alertas { border-left: 3px solid #ffa726; }
        .menu-btn.btn-alertas i { color: #ffa726; }

        .menu-btn.btn-recuperacion { border-left: 3px solid #ab47bc; }
        .menu-btn.btn-recuperacion i { color: #ce93d8; }

        .menu-btn.btn-reportes { border-left: 3px solid #42a5f5; }
        .menu-btn.btn-reportes i { color: #64b5f6; }

        .menu-btn.btn-informes { border-left: 3px solid #66bb6a; }
        .menu-btn.btn-informes i { color: #81c784; }

        .menu-btn.btn-recursos { border-left: 3px solid #26c6da; }
        .menu-btn.btn-recursos i { color: #4dd0e1; }

        .menu-btn.btn-salir { border-left: 3px solid #ef5350; background: rgba(239, 83, 80, 0.15); }
        .menu-btn.btn-salir i { color: #ef5350; }
        .menu-btn.btn-salir:hover { background: rgba(239, 83, 80, 0.3); }

        .footer-text {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.75em;
            font-weight: 300;
            text-align: center;
            margin-top: 15px;
        }

        @media (max-width: 768px) {
            .menu-btn { padding: 15px 8px; min-height: 90px; }
            .menu-btn i { font-size: 1.5em; }
            .menu-btn span { font-size: 0.75em; }
            .card-header-custom h1 { font-size: 1.2em; }
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">
    <div class="bg-menu"></div>
    <div class="overlay"></div>
    <div class="container py-4">
        <div class="main-wrapper">
            <div class="main-card">
                <div class="card-header-custom">
                    <img src="/images/sucua2.png" alt="Logo">
                    <h1>Sistema de Gestion Academica</h1>
                    <div class="period-selector">
                        <label>Periodo:</label>
                        <select id="selectorAnio" onchange="cambiarAnio(this.value)"></select>
                    </div>
                    <p class="user-info mt-2 mb-0">
                        <i class="fas fa-user me-1"></i>
                        <% const rolLabels = {docente:'Docente',secretaria:'Secretaria',rector:'Rector',inspector:'Inspector'}; %>
                        <%= user.nombre %> - <%= rolLabels[user.rol] || user.rol %>
                    </p>
                </div>
                <div class="menu-grid">
                    <div class="row g-3">

                        <% if (user.rol === 'docente') { %>
                        <div class="col-6 col-md-4">
                            <a href="/api/diagnostico/view" class="menu-btn btn-diagnostico">
                                <i class="fas fa-clipboard-list"></i>
                                <span>Prueba Diagnostico</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/notas/view" class="menu-btn btn-notas">
                                <i class="fas fa-chart-bar"></i>
                                <span>Notas Trimestrales</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/asistencias/view" class="menu-btn btn-asistencia">
                                <i class="fas fa-clipboard-check"></i>
                                <span>Asistencia</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/alertas/view" class="menu-btn btn-alertas">
                                <i class="fas fa-exclamation-triangle"></i>
                                <span>Alertas</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/recuperacion/view" class="menu-btn btn-recuperacion">
                                <i class="fas fa-hands-helping"></i>
                                <span>Recuperacion Pedagogica</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/reportes/view" class="menu-btn btn-reportes">
                                <i class="fas fa-file-alt"></i>
                                <span>Reportes</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/informes/view" class="menu-btn btn-informes">
                                <i class="fas fa-file-contract"></i>
                                <span>Informes</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/recursos/view" class="menu-btn btn-recursos">
                                <i class="fas fa-book-open"></i>
                                <span>Recursos</span>
                            </a>
                        </div>
                        <% } %>

                        <% if (user.rol === 'rector') { %>
                        <div class="col-6 col-md-4">
                            <a href="/api/rector/view" class="menu-btn btn-notas">
                                <i class="fas fa-school"></i>
                                <span>Gestion Academica</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/admin/view" class="menu-btn btn-diagnostico">
                                <i class="fas fa-users-cog"></i>
                                <span>Admin Usuarios</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/anio-lectivos/view" class="menu-btn btn-asistencia">
                                <i class="fas fa-calendar-alt"></i>
                                <span>Anos Lectivos</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/informes/view" class="menu-btn btn-informes">
                                <i class="fas fa-file-contract"></i>
                                <span>Informes</span>
                            </a>
                        </div>
                        <% } %>

                        <% if (user.rol === 'inspector') { %>
                        <div class="col-6 col-md-4">
                            <a href="/api/inspector/estudiantes/view" class="menu-btn btn-notas">
                                <i class="fas fa-user-graduate"></i>
                                <span>Estudiantes</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/asistencias/view" class="menu-btn btn-asistencia">
                                <i class="fas fa-clipboard-check"></i>
                                <span>Asistencia</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/reportes/view" class="menu-btn btn-informes">
                                <i class="fas fa-file-alt"></i>
                                <span>Reportes</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/alertas/view" class="menu-btn btn-alertas">
                                <i class="fas fa-exclamation-triangle"></i>
                                <span>Alertas</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/justificaciones/view" class="menu-btn btn-recursos">
                                <i class="fas fa-clipboard-list"></i>
                                <span>Justificaciones</span>
                            </a>
                        </div>
                        <% } %>

                        <% if (user.rol === 'secretaria') { %>
                        <div class="col-6 col-md-4">
                            <a href="/api/secretaria/view" class="menu-btn btn-recursos">
                                <i class="fas fa-user-graduate"></i>
                                <span>Ingreso de Estudiantes</span>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <a href="/api/secretaria/busqueda/view" class="menu-btn btn-notas">
                                <i class="fas fa-search"></i>
                                <span>Busqueda Estudiantes</span>
                            </a>
                        </div>
                        <% } %>

                        <div class="col-6 col-md-4">
                            <button onclick="window.location.href='/logout'" class="menu-btn btn-salir w-100">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Salir</span>
                            </button>
                        </div>

                    </div>
                </div>
            </div>
            <p class="footer-text mt-3">&copy; 2026 Sistema de Gestion Academica</p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const anioActual = '<%= user.anio_lectivo || "2026-2027" %>';

        document.addEventListener('DOMContentLoaded', cargarAnios);

        async function cargarAnios() {
            try {
                const res = await fetch('/api/years');
                const years = await res.json();
                const select = document.getElementById('selectorAnio');
                select.innerHTML = years.map(y =>
                    `<option value="${y}" ${y === anioActual ? 'selected' : ''}>${y}</option>`
                ).join('');
            } catch (err) {
                document.getElementById('selectorAnio').innerHTML = '<option value="2026-2027">2026-2027</option>';
            }
        }

        async function cambiarAnio(year) {
            try {
                const res = await fetch('/api/change-year', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ anio_lectivo: year })
                });
                if (res.ok) window.location.reload();
            } catch (err) {
                alert('Error al cambiar año lectivo');
            }
        }
    </script>
</body>
</html>
