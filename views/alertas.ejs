<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alertas Estudiantiles</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="/js/alertas.js" defer></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><img src="/images/sucua2.png" alt="Logo" style="width:40px; height:40px; border-radius:50%; margin-right:8px;">Sistema Academico</a>
            <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home me-1"></i>Menu Principal</a>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Alertas Estudiantiles</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3" id="filtrosAlertas">
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Curso</label>
                        <select id="filtroCurso" class="form-select form-select-sm" onchange="filtrarGrupos()">
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Paralelo</label>
                        <select id="filtroParalelo" class="form-select form-select-sm" onchange="filtrarGrupos()">
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Materia</label>
                        <select id="filtroMateria" class="form-select form-select-sm" onchange="filtrarGrupos()">
                            <option value="">Todas</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Especialidad</label>
                        <select id="filtroEspecialidad" class="form-select form-select-sm" onchange="filtrarGrupos()">
                            <option value="">Todas</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-outline-secondary btn-sm w-100" onclick="limpiarFiltrosAlertas()"><i class="fas fa-times me-1"></i>Limpiar</button>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Curso / Grupo</label>
                        <select id="alertaGrupoSelect" class="form-select" onchange="cargarAlertas()">
                            <option value="">Seleccionar curso...</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">% Min. Ausencia</label>
                        <input type="number" id="umbralAusencia" class="form-control" value="20" min="0" max="100" onchange="cargarAlertas()">
                    </div>
                    <% if (user.rol !== 'inspector') { %>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Nota Minima</label>
                        <input type="number" id="umbralRendimiento" class="form-control" value="7" min="0" max="10" step="0.1">
                    </div>
                    <% } %>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-warning w-100" onclick="cargarAlertas()"><i class="fas fa-search me-1"></i>Generar</button>
                    </div>
                </div>

                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tabInasistencia">
                            <i class="fas fa-user-times me-1"></i>Inasistencia
                        </a>
                    </li>
                    <% if (user.rol !== 'inspector') { %>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tabRendimiento">
                            <i class="fas fa-chart-line me-1"></i>Bajo Rendimiento
                        </a>
                    </li>
                    <% } %>
                </ul>

                <div class="tab-content mt-3">
                    <div class="tab-pane fade show active" id="tabInasistencia">
                        <div class="d-flex justify-content-end mb-2 gap-1">
                            <button id="btnTutorInasistencia" class="btn btn-info btn-sm" style="display:none" onclick="enviarWhatsAppTutor('inasistencia')">
                                <i class="fab fa-whatsapp me-1"></i> Enviar Resumen al Tutor
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="exportarPDFAlertas('tablaInasistencia', 'Alertas de Inasistencia')">
                                <i class="fas fa-file-pdf me-1"></i> PDF
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="tablaInasistencia">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Cedula</th>
                                        <th>Estudiante</th>
                                        <th>Materia</th>
                                        <th>Clases</th>
                                        <th>Ausencias</th>
                                        <th>% Ausencia</th>
                                        <th>Severidad</th>
                                        <th>WhatsApp</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyInasistencia"></tbody>
                            </table>
                        </div>
                    </div>
                    <% if (user.rol !== 'inspector') { %>
                    <div class="tab-pane fade" id="tabRendimiento">
                        <div class="d-flex justify-content-end mb-2 gap-1">
                            <button id="btnTutorRendimiento" class="btn btn-info btn-sm" style="display:none" onclick="enviarWhatsAppTutor('rendimiento')">
                                <i class="fab fa-whatsapp me-1"></i> Enviar Resumen al Tutor
                            </button>
                            <button class="btn btn-danger btn-sm" onclick="exportarPDFAlertas('tablaRendimiento', 'Alertas de Bajo Rendimiento')">
                                <i class="fas fa-file-pdf me-1"></i> PDF
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="tablaRendimiento">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Cedula</th>
                                        <th>Estudiante</th>
                                        <th>Materia</th>
                                        <th>Prom. Tareas</th>
                                        <th>Proyecto</th>
                                        <th>Examen</th>
                                        <th>Nota Final</th>
                                        <th>Severidad</th>
                                        <th>WhatsApp</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyRendimiento"></tbody>
                            </table>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
