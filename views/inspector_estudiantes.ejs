<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estudiantes - Inspector</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/"><img src="/images/sucua2.png" alt="Logo" style="width:40px; height:40px; border-radius:50%; margin-right:8px;">Sistema Academico</a>
            <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home me-1"></i>Menu Principal</a>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-user-graduate me-2"></i>Consulta de Estudiantes</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Cedula</label>
                        <input type="text" id="busCedula" class="form-control form-control-sm" placeholder="Cedula..." onkeyup="if(event.key==='Enter')buscarEstudiantes()">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Nombre</label>
                        <input type="text" id="busNombre" class="form-control form-control-sm" placeholder="Nombre o apellido..." onkeyup="if(event.key==='Enter')buscarEstudiantes()">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Curso</label>
                        <select id="busCurso" class="form-select form-select-sm">
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Paralelo</label>
                        <select id="busParalelo" class="form-select form-select-sm">
                            <option value="">Todos</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Especialidad</label>
                        <select id="busEspecialidad" class="form-select form-select-sm">
                            <option value="">Todas</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button class="btn btn-primary btn-sm w-100" onclick="buscarEstudiantes()"><i class="fas fa-search"></i></button>
                    </div>
                </div>

                <div id="resultadoBusqueda" class="table-responsive" style="max-height:400px; overflow-y:auto;">
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-search fa-3x mb-3"></i>
                        <p>Ingrese datos de busqueda y presione Buscar</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Detalle Estudiante -->
    <div class="modal fade" id="modalDetalle" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-user me-2"></i>Detalle del Estudiante</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="contenidoDetalle">
                    <div class="text-center"><div class="spinner-border text-primary"></div></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    async function cargarFiltros() {
        try {
            const res = await fetch('/api/inspector/estudiantes/buscar');
            const data = await res.json();
            const cursos = [...new Set(data.map(e => e.curso).filter(Boolean))].sort();
            const paralelos = [...new Set(data.map(e => e.paralelo).filter(Boolean))].sort();
            const especialidades = [...new Set(data.map(e => e.especialidad).filter(Boolean))].sort();
            cursos.forEach(c => { document.getElementById('busCurso').innerHTML += `<option value="${c}">${c}</option>`; });
            paralelos.forEach(p => { document.getElementById('busParalelo').innerHTML += `<option value="${p}">${p}</option>`; });
            especialidades.forEach(e => { document.getElementById('busEspecialidad').innerHTML += `<option value="${e}">${e}</option>`; });
        } catch(e) {}
    }

    async function buscarEstudiantes() {
        const params = new URLSearchParams();
        const cedula = document.getElementById('busCedula').value.trim();
        const nombre = document.getElementById('busNombre').value.trim();
        const curso = document.getElementById('busCurso').value;
        const paralelo = document.getElementById('busParalelo').value;
        const especialidad = document.getElementById('busEspecialidad').value;
        if (cedula) params.set('cedula', cedula);
        if (nombre) params.set('nombre', nombre);
        if (curso) params.set('curso', curso);
        if (paralelo) params.set('paralelo', paralelo);
        if (especialidad) params.set('especialidad', especialidad);

        const div = document.getElementById('resultadoBusqueda');
        div.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary"></div></div>';

        try {
            const res = await fetch('/api/inspector/estudiantes/buscar?' + params.toString());
            const data = await res.json();
            if (data.length === 0) {
                div.innerHTML = '<div class="text-center text-muted py-4"><i class="fas fa-user-slash fa-2x mb-2"></i><p>No se encontraron estudiantes</p></div>';
                return;
            }
            let html = `<table class="table table-sm table-striped table-hover"><thead class="table-dark"><tr>
                <th>#</th><th>Cedula</th><th>Nombre</th><th>Curso</th><th>Paralelo</th><th>Especialidad</th><th>Accion</th>
            </tr></thead><tbody>`;
            data.forEach((e, i) => {
                html += `<tr>
                    <td>${i+1}</td>
                    <td>${e.cedula || '-'}</td>
                    <td>${e.nombres_apellidos}</td>
                    <td>${e.curso || '-'}</td>
                    <td>${e.paralelo || '-'}</td>
                    <td>${e.especialidad || '-'}</td>
                    <td><button class="btn btn-sm btn-info" onclick="verDetalle(${e.id})" title="Ver detalle"><i class="fas fa-eye"></i></button></td>
                </tr>`;
            });
            html += '</tbody></table>';
            div.innerHTML = html;
        } catch(err) {
            div.innerHTML = '<div class="text-center text-danger py-3">Error al buscar estudiantes</div>';
        }
    }

    async function verDetalle(id) {
        const modal = new bootstrap.Modal(document.getElementById('modalDetalle'));
        const div = document.getElementById('contenidoDetalle');
        div.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary"></div></div>';
        modal.show();
        try {
            const res = await fetch('/api/inspector/estudiantes/' + id);
            const data = await res.json();
            if (data.error) { div.innerHTML = `<p class="text-danger">${data.error}</p>`; return; }
            const e = data.estudiante;
            let html = `<div class="row mb-3">
                <div class="col-md-6"><strong>Cedula:</strong> ${e.cedula || '-'}</div>
                <div class="col-md-6"><strong>Nombre:</strong> ${e.nombres_apellidos}</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4"><strong> Sexo:</strong> ${e.sexo || '-'}</div>
                <div class="col-md-4"><strong>Fecha Nac:</strong> ${e.fecha_nacimiento ? new Date(e.fecha_nacimiento).toLocaleDateString() : '-'}</div>
                <div class="col-md-4"><strong>Tipo Sangre:</strong> ${e.tipo_sangre || '-'}</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4"><strong>Curso:</strong> ${e.curso || '-'}</div>
                <div class="col-md-4"><strong>Paralelo:</strong> ${e.paralelo || '-'}</div>
                <div class="col-md-4"><strong>Especialidad:</strong> ${e.especialidad || '-'}</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6"><strong>Discapacidad:</strong> ${e.discapacidad || 'No'}</div>
                <div class="col-md-6"><strong>Tipo Discapacidad:</strong> ${e.discapacidad_tipo || '-'}</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-3"><strong>Pais:</strong> ${e.pais || '-'}</div>
                <div class="col-md-3"><strong>Provincia:</strong> ${e.provincia || '-'}</div>
                <div class="col-md-3"><strong>Ciudad:</strong> ${e.ciudad || '-'}</div>
                <div class="col-md-3"><strong>Parroquia:</strong> ${e.parroquia || '-'}</div>
            </div>
            <div class="mb-3"><strong>Direccion:</strong> ${e.direccion || '-'}</div>
            <hr>
            <h6 class="text-primary"><i class="fas fa-users me-1"></i>Datos del Representante</h6>
            <div class="row mb-3">
                <div class="col-md-4"><strong>Representante:</strong> ${e.representante || '-'}</div>
                <div class="col-md-4"><strong>Cedula:</strong> ${e.cedula_representante || '-'}</div>
                <div class="col-md-4"><strong>Parentesco:</strong> ${e.parentesco_representante || '-'}</div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4"><strong>Telefono:</strong> ${e.telefono_representante || '-'}</div>
                <div class="col-md-4"><strong>Email:</strong> ${e.email_representante || '-'}</div>
                <div class="col-md-4"><strong>Lugar Trabajo:</strong> ${e.lugar_trabajo_representante || '-'}</div>
            </div>
            <div class="mb-3"><strong>Matricula:</strong> ${e.numero_matricula || '-'}</div>`;

            if (data.grupos.length > 0) {
                html += '<hr><h6 class="text-primary"><i class="fas fa-book me-1"></i>Materias Inscritas</h6><ul class="list-group mb-3">';
                data.grupos.forEach(g => { html += `<li class="list-group-item">${g.nombre_materia} - ${g.curso} (${g.paralelo}) ${g.especialidad || ''}</li>`; });
                html += '</ul>';
            }

            if (data.asistencias.length > 0) {
                html += '<h6 class="text-primary"><i class="fas fa-clipboard-check me-1"></i>Resumen Asistencia</h6><table class="table table-sm table-bordered mb-3"><thead class="table-light"><tr><th>Materia</th><th>Clases</th><th>Presentes</th><th>Ausentes</th><th>%</th></tr></thead><tbody>';
                data.asistencias.forEach(a => {
                    const pct = a.total > 0 ? ((a.presentes / a.total) * 100).toFixed(1) : 0;
                    html += `<tr><td>${a.nombre_materia}</td><td>${a.total}</td><td>${a.presentes}</td><td class="text-danger">${a.ausentes}</td><td>${pct}%</td></tr>`;
                });
                html += '</tbody></table>';
            }

            if (data.notas.length > 0) {
                html += '<h6 class="text-primary"><i class="fas fa-sticky-note me-1"></i>Notas</h6><table class="table table-sm table-bordered"><thead class="table-light"><tr><th>Materia</th><th>Trimestre</th><th>Tipo</th><th>Nota</th></tr></thead><tbody>';
                data.notas.forEach(n => { html += `<tr><td>${n.nombre_materia}</td><td>${n.trimestre}</td><td>${n.tipo}</td><td>${n.nota}</td></tr>`; });
                html += '</tbody></table>';
            }

            div.innerHTML = html;
        } catch(err) {
            div.innerHTML = '<p class="text-danger">Error al cargar detalle</p>';
        }
    }

    document.addEventListener('DOMContentLoaded', cargarFiltros);
    </script>
</body>
</html>
