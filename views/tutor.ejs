<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tutor - Gestion Academica</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="/js/main.js" defer></script>
</head>
<body>
    <div class="container-fluid vh-100 d-flex flex-column">
        <header class="bg-purple text-white p-3 shadow" style="background:#8673ac;">
            <div class="container d-flex justify-content-between align-items-center">
                <h1 class="h4 mb-0"><i class="fas fa-user-tie me-2"></i>Tutoria de Curso</h1>
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-home"></i> Menu</a>
            </div>
        </header>
        <main class="flex-grow-1 overflow-auto py-3">
            <div class="container">
                <div class="card mb-3">
                    <div class="card-header"><i class="fas fa-chalkboard me-1"></i>Mis Cursos como Tutor</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Seleccionar curso</label>
                                <select class="form-select" id="selectCursoTutor" onchange="cambiarCursoTutor()">
                                    <option value="">Seleccionar curso...</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div id="infoCursoTutor" class="form-text fw-bold text-primary"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <ul class="nav nav-tabs mb-3" id="tabsTutor">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tabEstudiantes"><i class="fas fa-user-graduate me-1"></i>Estudiantes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tabFaltas" onclick="cargarFaltasTutor()"><i class="fas fa-user-slash me-1"></i>Faltas y Comentarios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tabComportamiento" onclick="cargarComportamientoTutor()"><i class="fas fa-clipboard-list me-1"></i>Comportamiento</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- PESTAÑA: ESTUDIANTES -->
                    <div class="tab-pane fade show active" id="tabEstudiantes">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-user-graduate me-1"></i>Estudiantes del Curso (<span id="contadorTutor">0</span>)</span>
                                <small class="text-muted">Solo puede editar datos personales, ubicacion y representante</small>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm table-hover">
                                        <thead class="table-dark text-center">
                                            <tr>
                                                <th>#</th>
                                                <th>Matricula</th>
                                                <th>Cedula</th>
                                                <th>Nombres y Apellidos</th>
                                                <th>Representante</th>
                                                <th>Telefono Rep.</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cuerpoEstudiantesTutor">
                                            <tr><td colspan="7" class="text-center text-muted">Seleccione un curso</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PESTAÑA: FALTAS Y COMENTARIOS -->
                    <div class="tab-pane fade" id="tabFaltas">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-user-slash me-1"></i>Faltas y Atrasos en todas las materias</span>
                                <button class="btn btn-sm btn-outline-primary" onclick="cargarFaltasTutor()"><i class="fas fa-sync me-1"></i>Actualizar</button>
                            </div>
                            <div class="card-body">
                                <div class="row g-2 mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold mb-1">Desde</label>
                                        <input type="date" class="form-control form-control-sm" id="faltaDesde">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold mb-1">Hasta</label>
                                        <input type="date" class="form-control form-control-sm" id="faltaHasta">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-bold mb-1">Tipo</label>
                                        <select class="form-select form-select-sm" id="faltaEstado">
                                            <option value="">Faltas y atrasos</option>
                                            <option value="ausente">Solo faltas</option>
                                            <option value="atraso">Solo atrasos</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end gap-2">
                                        <button class="btn btn-primary btn-sm" onclick="cargarFaltasTutor()">
                                            <i class="fas fa-search me-1"></i>Generar / Consultar
                                        </button>
                                    </div>
                                </div>
                                <div id="resumenFaltas" class="form-text fw-bold mb-2"></div>
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm table-hover">
                                        <thead class="table-dark text-center">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Estudiante</th>
                                                <th>Materia</th>
                                                <th>Estado</th>
                                                <th>Comentario del docente</th>
                                                <th>Docente</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cuerpoFaltasTutor">
                                            <tr><td colspan="6" class="text-center text-muted">Seleccione un curso</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PESTAÑA: COMPORTAMIENTO -->
                    <div class="tab-pane fade" id="tabComportamiento">
                        <div class="card mb-3">
                            <div class="card-header"><i class="fas fa-plus-circle me-1"></i>Registrar Comportamiento</div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold mb-1">Estudiante *</label>
                                        <select class="form-select form-select-sm" id="compEstudiante">
                                            <option value="">Seleccionar estudiante...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold mb-1">Fecha *</label>
                                        <input type="date" class="form-control form-control-sm" id="compFecha">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label fw-bold mb-1">Tipo</label>
                                        <select class="form-select form-select-sm" id="compTipo">
                                            <option value="observacion">Observacion</option>
                                            <option value="positivo">Positivo</option>
                                            <option value="negativo">Negativo</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold mb-1">Descripcion *</label>
                                        <input type="text" class="form-control form-control-sm" id="compDescripcion" placeholder="Detalle del comportamiento">
                                    </div>
                                </div>
                                <button class="btn btn-primary btn-sm mt-3" onclick="registrarComportamiento()"><i class="fas fa-save me-1"></i>Guardar Registro</button>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-history me-1"></i>Historial de Comportamiento</span>
                                <button class="btn btn-sm btn-outline-primary" onclick="cargarComportamientoTutor()"><i class="fas fa-sync me-1"></i>Actualizar</button>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm table-hover">
                                        <thead class="table-dark text-center">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Estudiante</th>
                                                <th>Tipo</th>
                                                <th>Descripcion</th>
                                                <th>Registrado por</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cuerpoComportamientoTutor">
                                            <tr><td colspan="6" class="text-center text-muted">Seleccione un curso</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        <footer class="bg-light text-center p-2 border-top">
            <small class="text-muted">&copy; 2026 Sistema de Gestion Academica</small>
        </footer>
    </div>

    <!-- Modal Editar Estudiante -->
    <div class="modal fade" id="modalEstudianteTutor" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" style="background:#8673ac;color:#fff;">
                    <h5 class="modal-title"><i class="fas fa-user-edit me-2"></i>Editar Estudiante</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form id="formEstudianteTutor" onsubmit="guardarEstudianteTutor(event)">
                    <div class="modal-body">
                        <input type="hidden" id="editTutorId">

                        <!-- DATOS DE MATRICULA (SOLO LECTURA) -->
                        <h6 class="text-secondary border-bottom pb-2 mb-3"><i class="fas fa-lock me-1"></i>Datos de Matricula (solo lectura)</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">N° Matricula</label>
                                <input type="text" class="form-control" id="infoMatricula" readonly disabled style="background:#e9ecef;">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Cedula</label>
                                <input type="text" class="form-control" id="infoCedula" readonly disabled style="background:#e9ecef;">
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label fw-bold">Año Lectivo</label>
                                <input type="text" class="form-control" id="infoAnio" readonly disabled style="background:#e9ecef;">
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label fw-bold">Curso</label>
                                <input type="text" class="form-control" id="infoCurso" readonly disabled style="background:#e9ecef;">
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label fw-bold">Paralelo</label>
                                <input type="text" class="form-control" id="infoParalelo" readonly disabled style="background:#e9ecef;">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Especialidad</label>
                            <input type="text" class="form-control" id="infoEspecialidad" readonly disabled style="background:#e9ecef;">
                        </div>

                        <!-- DATOS PERSONALES -->
                        <h6 class="text-primary border-bottom pb-2 mb-3 mt-4"><i class="fas fa-id-card me-1"></i>Datos del Estudiante</h6>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombres y Apellidos *</label>
                            <input type="text" class="form-control" id="campoNombreTutor" required>
                        </div>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Fecha Nacimiento</label>
                                <input type="date" class="form-control" id="campoFechaNacTutor" onchange="calcularEdadTutor()">
                            </div>
                            <div class="col-md-1 mb-3">
                                <label class="form-label fw-bold">Edad</label>
                                <input type="number" class="form-control" id="campoEdadTutor" readonly>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label fw-bold">Genero *</label>
                                <select class="form-select" id="campoSexoTutor" required>
                                    <option value="M">Masculino</option>
                                    <option value="F">Femenino</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Correo Electronico</label>
                                <input type="email" class="form-control" id="campoEmailTutor" placeholder="correo@ejemplo.com">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Tipo de Sangre</label>
                                <select class="form-select" id="campoTipoSangreTutor">
                                    <option value="">Seleccionar...</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Discapacidad</label>
                                <select class="form-select" id="campoDiscapacidadTutor" onchange="toggleDiscapacidadTutor()">
                                    <option value="NO">No</option>
                                    <option value="SI">Si</option>
                                </select>
                            </div>
                            <div class="col-md-9 mb-3" id="divDiscapacidadTipoTutor" style="display:none;">
                                <label class="form-label fw-bold">Tipo de Discapacidad</label>
                                <input type="text" class="form-control" id="campoDiscapacidadTipoTutor" placeholder="Ej: Visual, Auditiva, Motriz, Cognitive...">
                            </div>
                        </div>

                        <!-- UBICACION -->
                        <h6 class="text-primary border-bottom pb-2 mb-3 mt-4"><i class="fas fa-map-marker-alt me-1"></i>Datos de Ubicacion y Domicilio</h6>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Pais</label>
                                <input type="text" class="form-control" id="campoPaisTutor" placeholder="Pais">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Provincia</label>
                                <input type="text" class="form-control" id="campoProvinciaTutor" placeholder="Provincia">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Ciudad</label>
                                <input type="text" class="form-control" id="campoCiudadTutor" placeholder="Ciudad">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Parroquia</label>
                                <input type="text" class="form-control" id="campoParroquiaTutor" placeholder="Parroquia">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Direccion Exacta</label>
                            <input type="text" class="form-control" id="campoDireccionTutor" placeholder="Direccion del domicilio actual">
                        </div>

                        <!-- REPRESENTANTE -->
                        <h6 class="text-primary border-bottom pb-2 mb-3 mt-4"><i class="fas fa-user-tie me-1"></i>Datos del Representante Legal</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Nombres y Apellidos</label>
                                <input type="text" class="form-control" id="campoRepresentanteTutor" placeholder="Nombre del representante">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Cedula del Representante</label>
                                <input type="text" class="form-control" id="campoCedulaRepTutor" placeholder="Cedula">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">Parentesco</label>
                                <select class="form-select" id="campoParentescoRepTutor">
                                    <option value="">Seleccionar...</option>
                                    <option value="Padre">Padre</option>
                                    <option value="Madre">Madre</option>
                                    <option value="Abuelo/a">Abuelo/a</option>
                                    <option value="Tío/a">Tío/a</option>
                                    <option value="Hermano/a">Hermano/a</option>
                                    <option value="Tutor Legal">Tutor Legal</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Telefono Celular</label>
                                <input type="text" class="form-control" id="campoTelefonoRepTutor" placeholder="0999999999">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Correo del Representante</label>
                                <input type="email" class="form-control" id="campoEmailRepTutor" placeholder="correo@ejemplo.com">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Lugar de Trabajo</label>
                                <input type="text" class="form-control" id="campoTrabajoRepTutor" placeholder="Lugar de trabajo">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i>Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        let cursosTutor = [];
        let estudiantesTutor = [];

        document.addEventListener('DOMContentLoaded', () => {
            cargarMisCursos();
            document.getElementById('compFecha').value = new Date().toISOString().split('T')[0];
        });

        function cursoActual() {
            const idx = document.getElementById('selectCursoTutor').value;
            return idx === '' ? null : cursosTutor[parseInt(idx)];
        }

        async function cargarMisCursos() {
            try {
                const res = await fetch('/api/tutor/mis-cursos');
                cursosTutor = await res.json();
                const sel = document.getElementById('selectCursoTutor');
                sel.innerHTML = '<option value="">Seleccionar curso...</option>';
                cursosTutor.forEach((c, i) => {
                    const esp = c.especialidad ? ` (${c.especialidad})` : '';
                    sel.innerHTML += `<option value="${i}">${c.curso} ${c.paralelo}${esp}</option>`;
                });
                if (cursosTutor.length === 1) {
                    sel.value = '0';
                    cambiarCursoTutor();
                }
            } catch (err) {
                showNotification('Error al cargar cursos', 'danger');
            }
        }

        function cambiarCursoTutor() {
            cargarEstudiantesTutor();
            document.getElementById('cuerpoFaltasTutor').innerHTML = '<tr><td colspan="6" class="text-center text-muted">Presione "Generar / Consultar" para buscar faltas</td></tr>';
            document.getElementById('resumenFaltas').textContent = '';
            document.getElementById('cuerpoComportamientoTutor').innerHTML = '<tr><td colspan="6" class="text-center text-muted">Cargando...</td></tr>';
            cargarComportamientoTutor();
        }

        // ========== PESTAÑA ESTUDIANTES ==========
        async function cargarEstudiantesTutor() {
            const c = cursoActual();
            const tbody = document.getElementById('cuerpoEstudiantesTutor');
            const info = document.getElementById('infoCursoTutor');
            if (!c) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Seleccione un curso</td></tr>';
                document.getElementById('contadorTutor').textContent = '0';
                info.textContent = '';
                estudiantesTutor = [];
                return;
            }
            try {
                const params = new URLSearchParams({ curso: c.curso, paralelo: c.paralelo, especialidad: c.especialidad });
                const res = await fetch(`/api/tutor/estudiantes?${params}`);
                if (!res.ok) {
                    const err = await res.json();
                    showNotification(err.error || 'Error al cargar estudiantes', 'danger');
                    return;
                }
                estudiantesTutor = await res.json();
                poblarSelectEstudiantesComportamiento();
                info.textContent = `Curso: ${c.curso} ${c.paralelo}${c.especialidad ? ' - ' + c.especialidad : ''} · ${c.total_materias} materia(s)`;

                document.getElementById('contadorTutor').textContent = estudiantesTutor.length;
                if (estudiantesTutor.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">No hay estudiantes en este curso</td></tr>';
                    return;
                }
                let html = '';
                estudiantesTutor.forEach((e, i) => {
                    html += `
                        <tr>
                            <td class="text-center">${i + 1}</td>
                            <td class="text-center"><small>${e.numero_matricula || '-'}</small></td>
                            <td class="text-center"><small>${e.cedula}</small></td>
                            <td><small>${e.nombres_apellidos}</small></td>
                            <td><small>${e.representante || '-'}</small></td>
                            <td class="text-center"><small>${e.telefono_representante || '-'}</small></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning" onclick="editarEstudianteTutor(${e.id})" title="Editar datos">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </td>
                        </tr>`;
                });
                tbody.innerHTML = html;
            } catch (err) {
                showNotification('Error al cargar estudiantes', 'danger');
            }
        }

        function editarEstudianteTutor(id) {
            const e = estudiantesTutor.find(x => x.id === id);
            if (!e) return;

            document.getElementById('editTutorId').value = e.id;
            document.getElementById('infoMatricula').value = e.numero_matricula || '';
            document.getElementById('infoCedula').value = e.cedula || '';
            document.getElementById('infoAnio').value = e.anio_lectivo || '';
            document.getElementById('infoCurso').value = e.curso || '';
            document.getElementById('infoParalelo').value = e.paralelo || '';
            document.getElementById('infoEspecialidad').value = e.especialidad || '';

            document.getElementById('campoNombreTutor').value = e.nombres_apellidos || '';
            document.getElementById('campoFechaNacTutor').value = e.fecha_nacimiento ? String(e.fecha_nacimiento).split('T')[0] : '';
            document.getElementById('campoEdadTutor').value = e.edad || '';
            document.getElementById('campoSexoTutor').value = e.sexo || 'M';
            document.getElementById('campoEmailTutor').value = e.email || '';
            document.getElementById('campoTipoSangreTutor').value = e.tipo_sangre || '';
            document.getElementById('campoDiscapacidadTutor').value = e.discapacidad || 'NO';
            document.getElementById('campoDiscapacidadTipoTutor').value = e.discapacidad_tipo || '';
            toggleDiscapacidadTutor();

            document.getElementById('campoPaisTutor').value = e.pais || '';
            document.getElementById('campoProvinciaTutor').value = e.provincia || '';
            document.getElementById('campoCiudadTutor').value = e.ciudad || '';
            document.getElementById('campoParroquiaTutor').value = e.parroquia || '';
            document.getElementById('campoDireccionTutor').value = e.direccion || '';

            document.getElementById('campoRepresentanteTutor').value = e.representante || '';
            document.getElementById('campoCedulaRepTutor').value = e.cedula_representante || '';
            document.getElementById('campoParentescoRepTutor').value = e.parentesco_representante || '';
            document.getElementById('campoTelefonoRepTutor').value = e.telefono_representante || '';
            document.getElementById('campoEmailRepTutor').value = e.email_representante || '';
            document.getElementById('campoTrabajoRepTutor').value = e.lugar_trabajo_representante || '';

            new bootstrap.Modal(document.getElementById('modalEstudianteTutor')).show();
        }

        function toggleDiscapacidadTutor() {
            const si = document.getElementById('campoDiscapacidadTutor').value === 'SI';
            document.getElementById('divDiscapacidadTipoTutor').style.display = si ? 'block' : 'none';
        }

        function calcularEdadTutor() {
            const valor = document.getElementById('campoFechaNacTutor').value;
            if (!valor) { document.getElementById('campoEdadTutor').value = ''; return; }
            const hoy = new Date();
            const nac = new Date(valor);
            let edad = hoy.getFullYear() - nac.getFullYear();
            const m = hoy.getMonth() - nac.getMonth();
            if (m < 0 || (m === 0 && hoy.getDate() < nac.getDate())) edad--;
            document.getElementById('campoEdadTutor').value = edad;
        }

        async function guardarEstudianteTutor(e) {
            e.preventDefault();
            const id = document.getElementById('editTutorId').value;
            if (!id) return;

            const data = {
                nombres_apellidos: document.getElementById('campoNombreTutor').value,
                fecha_nacimiento: document.getElementById('campoFechaNacTutor').value,
                sexo: document.getElementById('campoSexoTutor').value,
                email: document.getElementById('campoEmailTutor').value,
                tipo_sangre: document.getElementById('campoTipoSangreTutor').value,
                discapacidad: document.getElementById('campoDiscapacidadTutor').value,
                discapacidad_tipo: document.getElementById('campoDiscapacidadTipoTutor').value,
                pais: document.getElementById('campoPaisTutor').value,
                provincia: document.getElementById('campoProvinciaTutor').value,
                ciudad: document.getElementById('campoCiudadTutor').value,
                parroquia: document.getElementById('campoParroquiaTutor').value,
                direccion: document.getElementById('campoDireccionTutor').value,
                representante: document.getElementById('campoRepresentanteTutor').value,
                cedula_representante: document.getElementById('campoCedulaRepTutor').value,
                parentesco_representante: document.getElementById('campoParentescoRepTutor').value,
                telefono_representante: document.getElementById('campoTelefonoRepTutor').value,
                email_representante: document.getElementById('campoEmailRepTutor').value,
                lugar_trabajo_representante: document.getElementById('campoTrabajoRepTutor').value
            };

            try {
                const res = await fetch(`/api/tutor/estudiantes/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (res.ok) {
                    showNotification(result.message, 'success');
                    bootstrap.Modal.getInstance(document.getElementById('modalEstudianteTutor')).hide();
                    await cargarEstudiantesTutor();
                    poblarSelectEstudiantesComportamiento();
                } else {
                    showNotification(result.error || 'Error', 'danger');
                }
            } catch (err) {
                showNotification('Error de conexion', 'danger');
            }
        }

        // ========== PESTAÑA FALTAS ==========
        async function cargarFaltasTutor() {
            const c = cursoActual();
            const tbody = document.getElementById('cuerpoFaltasTutor');
            const resumen = document.getElementById('resumenFaltas');
            if (!c) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Seleccione un curso</td></tr>';
                resumen.textContent = '';
                return;
            }
            const params = new URLSearchParams({
                curso: c.curso, paralelo: c.paralelo, especialidad: c.especialidad,
                desde: document.getElementById('faltaDesde').value,
                hasta: document.getElementById('faltaHasta').value,
                estado: document.getElementById('faltaEstado').value
            });
            try {
                const res = await fetch(`/api/tutor/faltas?${params}`);
                if (!res.ok) {
                    const err = await res.json();
                    showNotification(err.error || 'Error al cargar faltas', 'danger');
                    return;
                }
                const faltas = await res.json();
                const nAusente = faltas.filter(f => f.estado === 'ausente').length;
                const nAtraso = faltas.filter(f => f.estado === 'atraso').length;
                resumen.innerHTML = `<span class="text-danger">${nAusente} falta(s)</span> · <span class="text-warning">${nAtraso} atraso(s)</span>`;

                if (faltas.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-success">No hay faltas ni atrasos registrados</td></tr>';
                    return;
                }
                let html = '';
                faltas.forEach(f => {
                    const fecha = String(f.fecha).split('T')[0];
                    const badge = f.estado === 'ausente'
                        ? '<span class="badge bg-danger">Falta</span>'
                        : '<span class="badge bg-warning text-dark">Atraso</span>';
                    html += `
                        <tr>
                            <td class="text-center"><small>${fecha}</small></td>
                            <td><small>${f.nombres_apellidos}</small></td>
                            <td><small>${f.nombre_materia}</small></td>
                            <td class="text-center">${badge}</td>
                            <td><small>${f.comentario ? f.comentario : '<span class="text-muted">Sin comentario</span>'}</small></td>
                            <td><small>${f.docente}</small></td>
                        </tr>`;
                });
                tbody.innerHTML = html;
            } catch (err) {
                showNotification('Error al cargar faltas', 'danger');
            }
        }

        // ========== PESTAÑA COMPORTAMIENTO ==========
        function poblarSelectEstudiantesComportamiento() {
            const sel = document.getElementById('compEstudiante');
            const actual = sel.value;
            sel.innerHTML = '<option value="">Seleccionar estudiante...</option>';
            estudiantesTutor.forEach(e => {
                sel.innerHTML += `<option value="${e.id}">${e.nombres_apellidos} (${e.cedula})</option>`;
            });
            if (estudiantesTutor.some(e => e.id == actual)) sel.value = actual;
        }

        async function cargarComportamientoTutor() {
            const c = cursoActual();
            const tbody = document.getElementById('cuerpoComportamientoTutor');
            if (!c) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Seleccione un curso</td></tr>';
                return;
            }
            const params = new URLSearchParams({ curso: c.curso, paralelo: c.paralelo, especialidad: c.especialidad });
            try {
                const res = await fetch(`/api/tutor/comportamiento?${params}`);
                if (!res.ok) {
                    const err = await res.json();
                    showNotification(err.error || 'Error al cargar historial', 'danger');
                    return;
                }
                const registros = await res.json();
                if (registros.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No hay registros de comportamiento</td></tr>';
                    return;
                }
                let html = '';
                registros.forEach(r => {
                    const fecha = String(r.fecha).split('T')[0];
                    let badge;
                    if (r.tipo === 'positivo') badge = '<span class="badge bg-success">Positivo</span>';
                    else if (r.tipo === 'negativo') badge = '<span class="badge bg-danger">Negativo</span>';
                    else badge = '<span class="badge bg-info text-dark">Observacion</span>';
                    html += `
                        <tr>
                            <td class="text-center"><small>${fecha}</small></td>
                            <td><small>${r.nombres_apellidos}</small></td>
                            <td class="text-center">${badge}</td>
                            <td><small>${r.descripcion}</small></td>
                            <td><small>${r.registrado_por || '-'}</small></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-danger" onclick="eliminarComportamiento(${r.id})" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>`;
                });
                tbody.innerHTML = html;
            } catch (err) {
                showNotification('Error al cargar historial', 'danger');
            }
        }

        async function registrarComportamiento() {
            const c = cursoActual();
            if (!c) { showNotification('Seleccione un curso', 'warning'); return; }
            const estudiante_id = document.getElementById('compEstudiante').value;
            const fecha = document.getElementById('compFecha').value;
            const tipo = document.getElementById('compTipo').value;
            const descripcion = document.getElementById('compDescripcion').value.trim();
            if (!estudiante_id || !fecha || !descripcion) {
                showNotification('Estudiante, fecha y descripcion son requeridos', 'warning');
                return;
            }
            try {
                const res = await fetch('/api/tutor/comportamiento', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ estudiante_id: parseInt(estudiante_id), fecha, tipo, descripcion })
                });
                const result = await res.json();
                if (res.ok) {
                    showNotification(result.message, 'success');
                    document.getElementById('compDescripcion').value = '';
                    document.getElementById('compFecha').value = new Date().toISOString().split('T')[0];
                    await cargarComportamientoTutor();
                } else {
                    showNotification(result.error || 'Error', 'danger');
                }
            } catch (err) {
                showNotification('Error de conexion', 'danger');
            }
        }

        async function eliminarComportamiento(id) {
            if (!confirm('Eliminar este registro de comportamiento?')) return;
            try {
                const res = await fetch(`/api/tutor/comportamiento/${id}`, { method: 'DELETE' });
                const result = await res.json();
                if (res.ok) {
                    showNotification(result.message, 'success');
                    await cargarComportamientoTutor();
                } else {
                    showNotification(result.error || 'Error', 'danger');
                }
            } catch (err) {
                showNotification('Error de conexion', 'danger');
            }
        }
    </script>
</body>
</html>
